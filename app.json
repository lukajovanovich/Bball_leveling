{
  "expo": {
    "name": "Bball Leveling",
    "slug": "bball-leveling",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "bballleveling",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#05070D"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    }
  }
}
